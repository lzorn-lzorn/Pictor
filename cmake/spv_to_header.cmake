# spv_to_header.cmake
#
# Reads a binary SPIR-V file and writes a C/C++ header that defines an
# `unsigned char` array holding the raw bytes (little-endian, exactly as on
# disk). At runtime the array is reinterpret_cast'd to `const uint32_t*` and
# fed to VkShaderModuleCreateInfo, so no external .spv files are needed.
#
# Usage:
#   cmake -DINPUT=<path.spv> -DOUTPUT=<path.h> -DNAME=<identifier> \
#         -P spv_to_header.cmake

if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED NAME)
    message(FATAL_ERROR "spv_to_header.cmake requires INPUT, OUTPUT and NAME")
endif()

file(READ "${INPUT}" _data HEX)
string(LENGTH "${_data}" _hexlen)
math(EXPR _bytelen "${_hexlen} / 2")

set(NL "
")

set(_header "// Auto-generated by spv_to_header.cmake; do not edit.
#pragma once

// alignas(4) keeps the array 4-byte aligned, as required by Vulkan's
// VkShaderModuleCreateInfo::pCode (a const uint32_t* pointer).
alignas(4) static const unsigned char ${NAME}[] = {
")

set(_i 0)
while(_i LESS _bytelen)
    math(EXPR _hexpos "${_i} * 2")
    string(SUBSTRING "${_data}" ${_hexpos} 2 _byte)
    string(APPEND _header "0x${_byte},")

    math(EXPR _mod "${_i} % 16")
    if(_mod EQUAL 15)
        string(APPEND _header "${NL}")
    endif()

    math(EXPR _i "${_i} + 1")
endwhile()

string(APPEND _header "${NL}};${NL}")

file(WRITE "${OUTPUT}" "${_header}")
